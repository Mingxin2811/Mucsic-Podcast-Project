HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql://soundwave@127.0.0.1:5432/soundwave_dev

# In .env.test, provide the URL of a separate PostgreSQL 18 test database.
TEST_DATABASE_URL=

# Reserved for the account endpoints. Supply separate 32-byte secrets in base64url.
JWT_ISSUER=soundwave-api
JWT_AUDIENCE=soundwave-web
JWT_SECRET_BASE64URL=
OTP_HMAC_SECRET_BASE64URL=
RESEND_API_KEY=
RESEND_FROM=
